ent=\"Transparent, per-engagement pricing for DCF models, deal feasibility, and health snapshots.\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><meta property=\"og:title\" content=\"Vaelo | Institutional-grade financial analysis\"/><meta property=\"og:description\" content=\"Institutional-grade financial analysis for independent CA practices\"/><meta property=\"og:url\" content=\"https://vaelo.co.in\"/><meta property=\"og:site_name\" content=\"Vaelo\"/><meta property=\"og:locale\" content=\"en_IN\"/><meta property=\"og:image\" content=\"http://localhost:3000/opengraph-image?a67fca71f9856096\"/><meta property=\"og:image:type\" content=\"image/png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Vaelo - Institutional-grade financial analysis\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Vaelo | Institutional-grade financial analysis\"/><meta name=\"twitter:description\" content=\"Institutional-grade financial analysis for independent CA practices\"/><meta name=\"twitter:image\" content=\"http://localhost:3000/opengraph-image?a67fca71f9856096\"/><meta name=\"twitter:image:alt\" content=\"Vaelo - Institutional-grade financial analysis\"/><meta name=\"twitter:image:type\" content=\"image/png\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"icon\" href=\"/icon.svg?icon.3iysonzhh3pit.svg\" sizes=\"any\" type=\"image/svg+xml\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon?a0d61ffc213ad2ca\" type=\"image/png\" sizes=\"180x180\"/><meta name=\"next-size-adjust\" content=\"\"/><noscript><style>\n            /* Fallback for users with JS disabled: override framer-motion initial opacity: 0 */\n            div, span, p, h1, h2, h3, h4, h5, h6, section, article {\n              opacity: 1 !important;\n              transform: none !important;\n            }\n          </style></noscript><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col font-sans bg-paper text-ink\"><div hidden=\"\"><!--$--><!--/$--></div><nav class=\"border-b border-ledger-line bg-paper sticky top-0 z-50\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex justify-between h-16 items-center\"><div class=\"flex items-center\"><a class=\"flex items-center hover:opacity-80 transition-opacity duration-200\" href=\"/\"><img alt=\"Vaelo\" width=\"120\" height=\"36\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/branding/vaelo-logo-lockup.svg\"/></a></div><div class=\"hidden md:flex items-center space-x-8\"><a class=\"text-sm font-medium text-slate hover:text-corporate-blue transition-colors duration-200\" href=\"/how-it-works\">How it works</a><a class=\"text-sm font-medium text-slate hover:text-corporate-blue transition-colors duration-200\" href=\"/pricing\">Pricing</a><a class=\"text-sm font-medium text-slate hover:text-corporate-blue transition-colors duration-200\" href=\"/about\">About</a><a class=\"text-sm font-medium text-slate hover:text-corporate-blue transition-colors duration-200\" href=\"/contact\">Contact</a></div><div class=\"hidden md:block\"><a class=\"inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-sm text-paper bg-corporate-blue hover:bg-corporate-blue/90 hover:-translate-y-[1px] hover:shadow-sm transition-all duration-200\" href=\"/contact\">Get Started</a></div><div class=\"flex md:hidden items-center\"><button class=\"text-slate hover:text-corporate-blue focus:outline-none p-2\" aria-label=\"Toggle mobile menu\"><svg class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div></div></div></nav><div class=\"flex-grow\"><div style=\"opacity:0\"><main><section class=\"bg-paper py-24 border-b border-ledger-line\"><div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"mb-16 border-b border-ledger-line pb-8 text-center md:text-left\" style=\"opacity:0;transform:translateY(12px)\"><h1 class=\"text-4xl font-serif text-ink tracking-tight mb-4\">Transparent, Per-Engagement Pricing</h1><p class=\"text-xl text-slate leading-relaxed max-w-3xl\">No mandatory subscriptions. No complex tiers. Pay only for the rigor you need, exactly when your client needs it.</p></div><div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6 mb-16\" style=\"opacity:0\"><div class=\"border border-ledger-line bg-white flex flex-col hover:border-corporate-blue/50 hover:-translate-y-1 hover:shadow-md transition-all duration-200\" style=\"opacity:0;transform:translateY(12px)\"><div class=\"p-8 border-b border-ledger-line\"><h3 class=\"text-xl font-serif font-medium text-ink mb-6\">Valuation Report</h3><div class=\"flex items-baseline gap-2 mb-2\"><span class=\"text-3xl font-mono font-semibold text-corporate-blue tracking-tight\">₹1,500 – 3,000</span></div><span class=\"text-sm font-mono text-slate uppercase tracking-wider\">per report</span></div><div class=\"p-8 flex-grow\"><ul class=\"space-y-4\"><li class=\"flex items-start\"><span class=\"text-precision-green mr-3 font-mono\">✦</span><span class=\"text-sm text-slate\">Comprehensive DCF Model</span></li><li class=\"flex items-start\"><span class=\"text-precision-green mr-3 font-mono\">✦</span><span class=\"text-sm text-slate\">Comparable company analysis</span></li><li class=\"flex items-start\"><span class=\"text-precision-green mr-3 font-mono\">✦</span><span class=\"text-sm text-slate\">Sensitivity tables &amp; grids</span></li><li class=\"flex items-start\"><span class=\"text-precision-green mr-3 font-mono\">✦</span><span class=\"text-sm text-slate\">White-labeled PDF export</span></li></ul></div></div><div class=\"border border-ledger-line bg-white flex flex-col hover:border-corporate-blue/50 hover:-translate-y-1 hover:shadow-md transition-all duration-200\" style=\"opacity:0;transform:translateY(12px)\"><div class=\"p-8 border-b border-ledger-line\"><h3 class=\"text-xl font-serif font-medium text-ink mb-6\">Deal Feasibility Report</h3><div class=\"flex items-baseline gap-2 mb-2\"><span class=\"text-3xl font-mono font-semibold text-corporate-blue tracking-tight\">₹2,000 – 4,000</span></div><span class=\"text-sm font-mono text-slate uppercase tracking-wider\">per report</span></div><div class=\"p-8 flex-grow\"><ul class=\"space-y-4\"><li class=\"flex items-start\"><span class=\"text-precision-green mr-3 font-mono\">✦</span><span class=\"text-sm text-slate\">Accretion/dilution analysis</span></li><li class=\"flex items-start\"><span class=\"text-precision-green mr-3 font-mono\">✦</span><span class=\"text-sm text-slate\">Debt capacity modeling</span></li><li class=\"flex items-start\"><span class=\"text-precision-green mr-3 font-mono\">✦</span><span class=\"text-sm text-slate\">Synergy evaluations</span></li><li class=\"flex items-start\"><span class=\"text-precision-green mr-3 font-mono\">✦</span><span class=\"text-sm text-slate\">Pre/Post-transaction structuring</span></li></ul></div></div><div class=\"border border-ledger-line bg-white flex flex-col hover:border-corporate-blue/50 hover:-translate-y-1 hover:shadow-md transition-all duration-200\" style=\"opacity:0;transform:translateY(12px)\"><div class=\"p-8 border-b border-ledger-line\"><h3 class=\"text-xl font-serif font-medium text-ink mb-6\">Financial Health Snapshot</h3><div class=\"flex items-baseline gap-2 mb-2\"><span class=\"text-3xl font-mono font-semibold text-corporate-blue tracking-tight\">₹149 – 299</span></div><span class=\"text-sm font-mono text-slate uppercase tracking-wider\">per snapshot</span></div><div class=\"p-8 flex-grow\"><ul class=\"space-y-4\"><li class=\"flex items-start\"><span class=\"text-precision-green mr-3 font-mono\">✦</span><span class=\"text-sm text-slate\">Liquidity &amp; solvency ratios</span></li><li class=\"flex items-start\"><span class=\"text-precision-green mr-3 font-mono\">✦</span><span class=\"text-sm text-slate\">Working capital cycle analysis</span></li><li class=\"flex items-start\"><span class=\"text-precision-green mr-3 font-mono\">✦</span><span class=\"text-sm text-slate\">Distress flagging (Altman Z-score)</span></li><li class=\"flex items-start\"><span class=\"text-precision-green mr-3 font-mono\">✦</span><span class=\"text-sm text-slate\">Designed for recurring check-ins</span></li></ul></div></div></div><div class=\"bg-white border border-ledger-line p-8 lg:p-10 flex flex-col md:flex-row gap-8 items-start\" style=\"opacity:0;transform:translateY(12px)\"><div class=\"flex-1\"><h4 class=\"font-mono text-sm uppercase tracking-wider text-slate font-semibold mb-4 border-b border-ledger-line pb-2\">Pricing Principles</h4><ul class=\"space-y-4 text-sm text-ink leading-relaxed\"><li class=\"flex gap-3\"><span class=\"font-mono text-corporate-blue\">01</span><span><strong>No subscriptions:</strong> Pricing is strictly per-engagement. Start with a single report without any ongoing commitment.</span></li><li class=\"flex gap-3\"><span class=\"font-mono text-corporate-blue\">02</span><span><strong>No hidden fees:</strong> What you see is the final cost structure. A clean invoice is generated per request.</span></li></ul></div><div class=\"flex-1 bg-paper border border-ledger-line p-6 shadow-sm relative overflow-hidden\"><div class=\"absolute top-0 left-0 w-1 h-full bg-precision-green\"></div><h4 class=\"font-serif text-lg text-ink mb-2\">First-Report Pilot Offer</h4><p class=\"text-sm text-slate leading-relaxed mb-4\">We want to prove our rigorous modeling firsthand. Your first commissioned report is offered at a significant discount (or completely free) in exchange for your candid feedback on the output quality.</p></div></div></div></section><section class=\"bg-white py-24 border-b border-ledger-line\"><div class=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"border border-ledger-line p-10 lg:p-16 text-center\" style=\"opacity:0;transform:translateY(12px)\"><h2 class=\"text-3xl font-serif text-ink mb-6\">Why per-report, not a monthly platform fee?</h2><div class=\"text-slate text-lg leading-relaxed max-w-2xl mx-auto space-y-6\"><p>Most enterprise finance software forces you into an expensive annual seat license, regardless of how often you use the tool. But your practice&#x27;s advisory needs aren&#x27;t always linear.</p><p>Vaelo is built for the moments that matter—a crucial loan application, a potential sale, or a strategic merger—not for day-to-day bookkeeping monitoring.</p><p class=\"text-ink font-medium\">We believe you should only pay for institutional-grade rigor when you actually need it. Our pricing matches how independent practices actually operate.</p></div></div></div></section><section class=\"bg-corporate-blue text-paper py-24\"><div class=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center\" style=\"opacity:0;transform:translateY(12px)\"><h2 class=\"text-3xl sm:text-4xl font-serif mb-6\">Ready to elevate your advisory practice?</h2><p class=\"text-blue-100 text-lg mb-10 max-w-2xl mx-auto\">Request a sample report today to see the rigor of our analysis firsthand. First-time practices can commission their first client report at a discounted pilot rate.</p><a class=\"inline-flex justify-center items-center px-8 py-4 border border-transparent text-base font-medium rounded-sm text-corporate-blue bg-white hover:bg-slate-50 hover:-translate-y-[1px] hover:shadow-md transition-all duration-200\" href=\"/contact\">Request a sample report</a><p class=\"mt-6 text-sm font-mono text-blue-200\">No subscription required. Pay per report.</p></div></section></main><!--$--><!--/$--></div></div><footer class=\"bg-ink text-paper border-t border-ledger-line/20 py-12\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"grid grid-cols-1 md:grid-cols-4 gap-8\" style=\"opacity:0\"><div class=\"col-span-1 md:col-span-2\" style=\"opacity:0;transform:translateY(12px)\"><a class=\"inline-flex items-center gap-3 group\" href=\"/\"><div class=\"bg-paper p-1.5 rounded-sm shadow-sm flex items-center justify-center transition-transform duration-200 group-hover:scale-105\"><img alt=\"Vaelo Icon\" loading=\"lazy\" width=\"28\" height=\"28\" decoding=\"async\" data-nimg=\"1\" class=\"w-7 h-7\" style=\"color:transparent\" src=\"/branding/vaelo-icon.svg\"/></div><span class=\"font-serif text-2xl font-semibold tracking-tight text-paper transition-opacity duration-200 group-hover:opacity-90\">Vaelo</span></a><p class=\"mt-4 text-sm text-slate-300 max-w-xs leading-relaxed\">Institutional-grade financial analysis, purpose-built for independent Chartered Accountants in India.</p></div><div class=\"\" style=\"opacity:0;transform:translateY(12px)\"><h3 class=\"text-sm font-semibold uppercase tracking-wider text-slate-400 mb-4 font-mono\">Platform</h3><ul class=\"space-y-3\"><li><a class=\"text-sm text-slate-300 hover:text-white transition-colors duration-200\" href=\"/how-it-works\">How It Works</a></li><li><a class=\"text-sm text-slate-300 hover:text-white transition-colors duration-200\" href=\"/pricing\">Pricing</a></li><li><a class=\"text-sm text-slate-300 hover:text-white transition-colors duration-200\" href=\"/about\">About Us</a></li></ul></div><div class=\"\" style=\"opacity:0;transform:translateY(12px)\"><h3 class=\"text-sm font-semibold uppercase tracking-wider text-slate-400 mb-4 font-mono\">Legal</h3><ul class=\"space-y-3\"><li><a class=\"text-sm text-slate-300 hover:text-white transition-colors duration-200\" href=\"/contact\">Contact</a></li><li><a class=\"text-sm text-slate-300 hover:text-white transition-colors duration-200\" href=\"/privacy-policy\">Privacy Policy</a></li><li><a class=\"text-sm text-slate-300 hover:text-white transition-colors duration-200\" href=\"/terms\">Terms of Service</a></li></ul></div></div><div class=\"mt-12 pt-8 border-t border-slate-700/50 flex flex-col md:flex-row justify-between items-center\" style=\"opacity:0;transform:translateY(12px)\"><p class=\"text-sm text-slate-400 font-mono\">© <!-- -->2026<!-- --> Vaelo. All rights reserved.</p><p class=\"text-sm text-slate-400 mt-4 md:mt-0 font-mono\">Encrypted &amp; DPDP Act Conscious</p></div></div></footer><script src=\"/_next/static/chunks/3s6nzrbk-8mnv.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n3:I[84834,[\\\"/_next/static/chunks/3qmmyx4fljb30.js\\\",\\\"/_next/static/chunks/2l26vd-in2vdj.js\\\"],\\\"Nav\\\"]\\n4:I[7562,[\\\"/_next/static/chunks/3qmmyx4fljb30.js\\\",\\\"/_next/static/chunks/2l26vd-in2vdj.js\\\"],\\\"PageTransition\\\"]\\n5:I[39756,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"default\\\"]\\n6:I[37457,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"default\\\"]\\n7:I[22016,[\\\"/_next/static/chunks/3qmmyx4fljb30.js\\\",\\\"/_next/static/chunks/2l26vd-in2vdj.js\\\"],\\\"\\\"]\\n8:I[63935,[\\\"/_next/static/chunks/3qmmyx4fljb30.js\\\",\\\"/_next/static/chunks/2l26vd-in2vdj.js\\\"],\\\"RevealGroup\\\"]\\n9:I[63935,[\\\"/_next/static/chunks/3qmmyx4fljb30.js\\\",\\\"/_next/static/chunks/2l26vd-in2vdj.js\\\"],\\\"RevealItem\\\"]\\na:I[85437,[\\\"/_next/static/chunks/3qmmyx4fljb30.js\\\",\\\"/_next/static/chunks/2l26vd-in2vdj.js\\\"],\\\"Image\\\"]\\n12:I[68027,[\\\"/_next/static/chunks/3qmmyx4fljb30.js\\\",\\\"/_next/static/chunks/2l26vd-in2vdj.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/4194vy8pwc8fi.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/115e7a2565b70400-s.p.1vgtwd90zpq_8.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/70bc3e132a0a741e-s.p.3t6q91iet4nsy.woff2\\\",\\\"font\\\",{