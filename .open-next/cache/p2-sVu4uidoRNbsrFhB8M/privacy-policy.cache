ding-relaxed mb-6\\\",\\\"children\\\":[\\\"Vaelo (\\\\\\\"we\\\\\\\", \\\\\\\"our\\\\\\\", or \\\\\\\"us\\\\\\\") provides institutional-grade financial analysis tools exclusively for Chartered Accountants (CAs) and financial professionals. Because you entrust us with sensitive client financial data, our privacy principles are simple: \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"we collect only what is necessary to generate your reports, we protect it rigorously, and we never use your clients' data to train public AI models.\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"This Privacy Policy explains how we collect, use, and protect your information, and how we comply with the Digital Personal Data Protection (DPDP) Act of India.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl mt-10 mb-4\\\",\\\"children\\\":\\\"1. What Data We Collect\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"To provide our services, we collect the following types of information:\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"list-disc pl-5 space-y-2 mt-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Account Information:\\\"}],\\\" Your name, firm name, email address, and billing details.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"WhatsApp Contact Information:\\\"}],\\\" The verified phone number you provide to receive your generated reports via the WhatsApp Business API.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Client Financial Data:\\\"}],\\\" The raw financial data you submit for analysis. This includes Tally or Zoho exports, manual Profit \\u0026 Loss statements, Balance Sheets, and specific transaction assumptions needed to generate Valuation or Deal Feasibility reports.\\\"]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl mt-10 mb-4\\\",\\\"children\\\":\\\"2. How We Use Your Data\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Your data is used strictly to deliver the service you requested. We use the information to:\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"list-disc pl-5 space-y-2 mt-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Ingest and structure financial data to generate deterministic financial models (e.g., DCF valuations).\\\"}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Deliver the final, white-labeled PDF reports to you via WhatsApp or email.\\\"}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Provide customer support and respond to your inquiries.\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-4 font-medium text-ink bg-paper p-4 border border-ledger-line rounded-sm\\\",\\\"children\\\":\\\"We do not sell your data. We do not share your clients' financial data with unauthorized third parties. We strictly do not use your proprietary financial submissions to train external, shared, or public AI models.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl mt-10 mb-4\\\",\\\"children\\\":\\\"3. Data Storage, Security \\u0026 Hosting\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"We implement robust security measures to protect your data against unauthorized access or disclosure:\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"list-disc pl-5 space-y-2 mt-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Encryption:\\\"}],\\\" All data is encrypted at rest and in transit using industry-standard protocols (TLS/SSL).\\\"]}],\\\"$L15\\\",\\\"$L16\\\"]}]]}],\\\"$L17\\\",\\\"$L18\\\",\\\"$L19\\\",\\\"$L1a\\\",\\\"$L1b\\\"]}]]}]}],\\\"$L1c\\\"]}],null,\\\"$L1d\\\"]