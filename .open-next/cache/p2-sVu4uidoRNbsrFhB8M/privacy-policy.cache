y-20 border-b border-ledger-line\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-12 border-b border-ledger-line pb-8\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-4xl font-serif text-ink tracking-tight mb-4\",\"children\":\"Privacy Policy\"}],[\"$\",\"p\",null,{\"className\":\"text-slate text-sm font-mono uppercase tracking-wider\",\"children\":[\"Effective Date: \",\"18 August 2026\"]}]]}],[\"$\",\"div\",null,{\"className\":\"prose prose-slate prose-headings:font-serif prose-headings:text-ink prose-headings:font-medium prose-p:text-slate prose-a:text-corporate-blue max-w-none space-y-8\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg leading-relaxed mb-6\",\"children\":[\"Vaelo (\\\"we\\\", \\\"our\\\", or \\\"us\\\") provides institutional-grade financial analysis tools exclusively for Chartered Accountants (CAs) and financial professionals. Because you entrust us with sensitive client financial data, our privacy principles are simple: \",[\"$\",\"strong\",null,{\"children\":\"we collect only what is necessary to generate your reports, we protect it rigorously, and we never use your clients' data to train public AI models.\"}]]}],[\"$\",\"p\",null,{\"children\":\"This Privacy Policy explains how we collect, use, and protect your information, and how we comply with the Digital Personal Data Protection (DPDP) Act of India.\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl mt-10 mb-4\",\"children\":\"1. What Data We Collect\"}],[\"$\",\"p\",null,{\"children\":\"To provide our services, we collect the following types of information:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-2 mt-4\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Account Information:\"}],\" Your name, firm name, email address, and billing details.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"WhatsApp Contact Information:\"}],\" The verified phone number you provide to receive your generated reports via the WhatsApp Business API.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Client Financial Data:\"}],\" The raw financial data you submit for analysis. This includes Tally or Zoho exports, manual Profit & Loss statements, Balance Sheets, and specific transaction assumptions needed to generate Valuation or Deal Feasibility reports.\"]}]]}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl mt-10 mb-4\",\"children\":\"2. How We Use Your Data\"}],[\"$\",\"p\",null,{\"children\":\"Your data is used strictly to deliver the service you requested. We use the information to:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-2 mt-4\",\"children\":[[\"$\",\"li\",null,{\"children\":\"Ingest and structure financial data to generate deterministic financial models (e.g., DCF valuations).\"}],[\"$\",\"li\",null,{\"children\":\"Deliver the final, white-labeled PDF reports to you via WhatsApp or email.\"}],[\"$\",\"li\",null,{\"children\":\"Provide customer support and respond to your inquiries.\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 font-medium text-ink bg-paper p-4 border border-ledger-line rounded-sm\",\"children\":\"We do not sell your data. We do not share your clients' financial data with unauthorized third parties. We strictly do not use your proprietary financial submissions to train external, shared, or public AI models.\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl mt-10 mb-4\",\"children\":\"3. Data Storage, Security & Hosting\"}],[\"$\",\"p\",null,{\"children\":\"We implement robust security measures to protect your data against unauthorized access or disclosure:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-2 mt-4\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Encryption:\"}],\" All data is encrypted at rest and in transit using industry-standard protocols (TLS/SSL).\"]}],\"$L15\",\"$L16\"]}]]}],\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\"]}]]}]}],\"$L1c\"]}],null,\"$L1d\"]}]\n11:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L1e\",null,{\"children\":\"$L1f\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L20\",null,{\"children\":[\"$\",\"$21\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L22\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n13:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/4194vy8pwc8fi.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n23:I[97367,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"OutletBoundary\"]\n10:C\n15:[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Isolation:\"}],\" Client data is logically isolated between individual CA accounts. You cannot access another practice's data, and they cannot access yours.\"]}]\n16:[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Data Residency:\"}],\" Our primary databases and hosting infrastructure are located in secure, India-based data centers to comply with local data sovereignty preferences.\"]}]\n17:[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl mt-10 mb-4\",\"children\":\"4. Third-Party Services\"}],[\"$\",\"p\",null,{\"children\":\"We utilize select, trusted third-party infrastructure providers to deliver our service. These providers are bound by strict data processing agreements:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-2 mt-4\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Meta (WhatsApp Business API):\"}],\" Used exclusively to deliver your completed reports and critical notifications securely to your registered WhatsApp number.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Supabase & Deno Deploy:\"}],\" Used for secure database hosting, authentication, application logic (Edge Functions), and encrypted file storage of your generated PDF reports.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Payment Processors:\"}],\" We use secure, compliant payment gateways (e.g., Razorpay/Stripe) to process invoice payments. We do not store your credit card numbers on our servers.\"]}]]}]]}]\n18:[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl mt-10 mb-4\",\"children\":\"5. Data Retention & Deletion\"}],[\"$\",\"p\",null,{\"children\":\"We retain your account information and generated reports for as long as your account is active, allowing you to access historical valuations.\"}],[\"$\",\"p\",null,{\"className\":\"mt-2\",\"children\":\"If you delete a client profile or close your Vaelo account, the associated raw financial data and generated reports are permanently deleted from our active databases within 30 days. You may request immediate deletion of specific client data at any time after a report is finalized.\"}]]}]\n19:[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl mt-10 mb-4\",\"children\":\"6. Your Rights Under the DPDP Act\"}],[\"$\",\"p\",null,{\"children\":\"In compliance with the Digital Personal Data Protection (DPDP) Act of India, you (and by extension, your clients) hold the following rights regarding personal data:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc pl-5 space-y-2 mt-4\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Right to Access:\"}],\" You can request a summary of the personal data we hold about you.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Right to Correction:\"}],\" You can request that we correct any inaccurate or incomplete data.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Right to Erasure:\"}],\" You can request the deletion of your personal data when it is no longer necessary for the purpose it was collected.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Right to Grievance Redressal:\"}],\" You have the right to register a complaint regarding data processing.\"]}]]}]]}]\n1a:[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl mt-10 mb-4\",\"children\":\"7. Updates to This Policy\"}],[\"$\",\"p\",null,{\"children\":\"We may update this Privacy Policy periodically to reflect changes in our practices or regulatory requirements. We will notify you of any material changes by sending an alert to your registered WhatsApp number or email address, or by placing a prominent notice on our website prior to the change becoming effective.\"}]]}]\n1b:[\"$\",\"div\",null,{\"className\":\"pt-8 mt-12 border-t border-ledger-line\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl mb-4\",\"children\":\"8. Contact Information\"}],[\"$\",\"p\",null,{\"children\":\"If you have any questions about this Privacy Policy, your data rights, or our security practices, please contact our Data Protection/Privacy Officer at:\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 font-mono font-medium text-corporate-blue\",\"children\":\"vaelo.team@gmail.com\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-slate\",\"children\":\"(We will update this to privacy@vaelo.co.in once the custom domain email is fully provisioned.)\"}]]}]\n1c:[\"$\",\"section\",null,{\"className\":\"bg-corporate-blue text-paper py-24\",\"children\":[\"$\",\"$L14\",null,{\"className\":\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-3xl sm:text-4xl font-serif mb-6\",\"children\":\"Ready to elevate your advisory practice?\"}],[\"$\",\"p\",null,{\"className\":\"text-blue-100 text-lg mb-10 max-w-2xl mx-auto\",\"children\":\"Reque